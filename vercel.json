{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/lab",
      "destination": "/lab.html"
    },
    {
      "source": "/solutions",
      "destination": "/solutions.html"
    },
    {
      "source": "/pricing",
      "destination": "/pricing.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/faq",
      "destination": "/faq.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/cookie",
      "destination": "/cookie.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/sdk-config",
      "destination": "/sdk-config.html"
    },
    {
      "source": "/search",
      "destination": "/search.html"
    },
    {
      "source": "/articles/a14",
      "destination": "/articles/a14.html"
    },
    {
      "source": "/articles/a15",
      "destination": "/articles/a15.html"
    },
    {
      "source": "/articles/a16",
      "destination": "/articles/a16.html"
    },
    {
      "source": "/articles/a17",
      "destination": "/articles/a17.html"
    },
    {
      "source": "/articles/a18",
      "destination": "/articles/a18.html"
    },
    {
      "source": "/articles/a19",
      "destination": "/articles/a19.html"
    },
    {
      "source": "/articles/a20",
      "destination": "/articles/a20.html"
    },
    {
      "source": "/products/t4-ecommerce",
      "destination": "/products/t4-ecommerce.html"
    },
    {
      "source": "/products/r2.5-content-engine",
      "destination": "/products/r2.5-content-engine.html"
    },
    {
      "source": "/products/s1-flash-page",
      "destination": "/products/s1-flash-page.html"
    },
    {
      "source": "/products/a1-ai-card",
      "destination": "/products/a1-ai-card.html"
    },
    {
      "source": "/products/b2b-industry",
      "destination": "/products/b2b-industry.html"
    },
    {
      "source": "/products/vip-annual",
      "destination": "/products/vip-annual.html"
    },
    {
      "source": "/services",
      "destination": "/services.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/disclaimer",
      "destination": "/disclaimer.html"
    },
    {
      "source": "/articles",
      "destination": "/articles/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)\\.html",
      "destination": "/$1",
      "permanent": true
    },
    {
      "source": "/t",
      "destination": "https://tower.xingdeng.tw/firstlight",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com https://plausible.io https://www.googletagmanager.com https://www.google-analytics.com https://snt-omni-ad-bot.vercel.app https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https:; media-src 'self' https:; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://plausible.io https://snt-omni-ad-bot.vercel.app https://api.line.me https://vip.xingdeng.tw; frame-src 'self' https://www.googletagmanager.com https://td.doubleclick.net; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "off"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/evbeat",
      "schedule": "23 0 * * *"
    }
  ]
}