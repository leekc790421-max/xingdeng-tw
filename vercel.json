{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/lab", "destination": "/lab.html" },
    { "source": "/solutions", "destination": "/solutions.html" },
    { "source": "/pricing", "destination": "/pricing.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/cookie", "destination": "/cookie.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/sdk-config", "destination": "/sdk-config.html" },
    { "source": "/articles/a14", "destination": "/articles/a14.html" },
    { "source": "/articles/a15", "destination": "/articles/a15.html" },
    { "source": "/articles/a16", "destination": "/articles/a16.html" },
    { "source": "/articles/a17", "destination": "/articles/a17.html" },
    { "source": "/articles/a18", "destination": "/articles/a18.html" },
    { "source": "/articles/a19", "destination": "/articles/a19.html" },
    { "source": "/articles/a20", "destination": "/articles/a20.html" },
    { "source": "/products/t4-ecommerce", "destination": "/products/t4-ecommerce.html" },
    { "source": "/products/r2.5-content-engine", "destination": "/products/r2.5-content-engine.html" },
    { "source": "/products/s1-flash-page", "destination": "/products/s1-flash-page.html" },
    { "source": "/products/a1-ai-card", "destination": "/products/a1-ai-card.html" },
    { "source": "/products/b2b-industry", "destination": "/products/b2b-industry.html" },
    { "source": "/products/vip-annual", "destination": "/products/vip-annual.html" }
  ],
  "redirects": [
    { "source": "/(.*)\\.html", "destination": "/$1", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
